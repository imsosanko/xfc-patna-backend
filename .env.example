# Copy this file to .env and fill in real values.
# Your original .env (with real secrets) was intentionally NOT included in
# this redesign package — recreate it from your live Render environment
# variables (Render dashboard → your service → Environment tab).

NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# MongoDB Atlas connection string (Database Access → your cluster → Connect)
MONGODB_URI=mongodb+srv://xfc_admin:PASSWORD@cluster.mongodb.net/xfc_patna

# From @BotFather when you created the bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Any long random string, minimum 32 characters, different for each of these two
JWT_SECRET=your_member_jwt_secret_min_32_chars
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_chars

# Your deployed Member App URL (used for CORS)
FRONTEND_URL=https://xfc-patna.vercel.app
